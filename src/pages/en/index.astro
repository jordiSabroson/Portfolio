---
import "../styles/global.css";

import Layout from "../../layouts/Layout.astro";
import Header from "../../components/Header.astro";

import Experience from "../../components/Experience.astro";
import Section from "../../components/Section.astro";
import TitleSection from "../../components/TitleSection.astro";
import Projects from "../../components/Projects.astro";

import BriefcaseIcon from "../../icons/Briefcase.astro";
import CodeIcon from "../../icons/Code.astro";
import Hello from "../../components/Hello.astro";
---
<Header />
<Layout
	
	title="Jordi's Portfolio | AI Programmer & Web Developer"
	description=""
>
	<main class="px-4">
		<!-- Hello, I am Jordi! -->
		<Section class="py-16 md:py-36">
			<Hello>
				<slot />
			</Hello>
		</Section>

		<div class="space-y-24">
			<Section id="experience">
				<TitleSection>
					<BriefcaseIcon class="size-8" />
					Experiència laboral
				</TitleSection>
				<Experience />
			</Section>

			<Section id="projects">
				<TitleSection>
					<CodeIcon class="size-8" />
					Projectes
				</TitleSection>
				<Projects />
			</Section>
		</div>
	</main>
</Layout>
